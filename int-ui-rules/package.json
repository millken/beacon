{
  "name": "int-ui-rules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/normalize-tokens.mjs",
    "generate": "node scripts/generate.mjs",
    "docs": "npm run generate",
    "preview": "node scripts/serve-docs.mjs",
    "build": "npm run tokens && npm run generate && tailwindcss -i dist/tailwind.input.css -o dist/tailwind.css --minify",
    "diff": "node scripts/diff.mjs",
    "verify": "npm run build && npm run check && npm run diff",
    "check": "node scripts/checks.mjs",
    "extract:help": "node scripts/extract-component.mjs",
    "raster:floor": "node scripts/raster-floor-probe.mjs"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "pixelmatch": "^7.1.0",
    "tailwindcss": "^4.3.4"
  }
}
